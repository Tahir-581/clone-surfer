name: "whisper_large_v3"
backend: "python"

max_batch_size: 8

input [
  {
    name: "audio_b64"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "task"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "language"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "text"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 2, 4, 8 ]
  max_queue_delay_microseconds: 5000
}

instance_group [
  {
    kind: KIND_GPU
    count: 1
    # When the container is started with `--gpus "device=1"`, physical GPU1 is
    # exposed as the only visible GPU (device 0) inside the container.
    gpus: [ 0 ]
  }
]
