#!/usr/bin/env python3
import os
import subprocess
import sys


def main() -> int:
    cmd = [
        "python3",
        "-m",
        "vllm.entrypoints.openai.api_server",
        "--model",
        "BAAI/bge-reranker-v2-m3",
        "--runner",
        "pooling",
        "--trust-remote-code",
        "--host",
        "0.0.0.0",
        "--port",
        "8019",
        "--gpu-memory-utilization",
        "0.10",
        "--enforce-eager",
    ]
    env = os.environ.copy()
    env["CUDA_VISIBLE_DEVICES"] = "0"
    return subprocess.call(cmd, env=env)


if __name__ == "__main__":
    sys.exit(main())
